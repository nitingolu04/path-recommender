# Optional LLM configuration for the "Ask a question" box.
#
# HOW TO USE
#   1. Copy this file to .streamlit/secrets.toml  (that filename is gitignored)
#   2. Paste your key into LPR_LLM_API_KEY
#   3. Restart the app
#
# WITHOUT THIS FILE the app works exactly as before: questions are answered by
# built-in templates covering why / prerequisites / difficulty / duration / skills.
# The LLM only widens the range of questions that can be answered; nothing else in
# the app depends on it, and no recommendation logic uses it.
#
# NEVER COMMIT secrets.toml. If a key is ever pushed, revoke it immediately —
# rotating is cheap, a leaked key is not.

# ── Minimum viable config ─────────────────────────────────────────────────────
# A key on its own is enough. The provider is inferred, and a default model is
# chosen for it.
LPR_LLM_API_KEY = "paste-your-key-here"


# ── Optional overrides ────────────────────────────────────────────────────────
# Uncomment and edit as needed.

# Which provider to use: "openai" | "groq" | "openrouter" | "gemini"
# LPR_LLM_PROVIDER = "gemini"

# Model name. Set this if the default is not available to your account — model
# names change often, and a wrong one shows up as a 404 in the answer caption.
# LPR_LLM_MODEL = "gemini-2.0-flash"

# Base URL, for any OpenAI-compatible host. This is what lets you point at a
# local server instead of a paid API.
# LPR_LLM_BASE_URL = "https://api.groq.com/openai/v1"

# Seconds to wait before giving up and falling back to templates.
# LPR_LLM_TIMEOUT = "20"


# ── Examples ──────────────────────────────────────────────────────────────────
#
# Google Gemini (has a free tier):
#   LPR_LLM_PROVIDER = "gemini"
#   LPR_LLM_API_KEY  = "AQ.Ab8RN6IzpUGuqKwP7mX--GSQVzlUhplGFDMPRZ4JRiUgmQRw8g"
#   LPR_LLM_MODEL    = "gemini-2.0-flash"
#
# Groq (fast, free tier):
#   LPR_LLM_PROVIDER = "groq"
#   LPR_LLM_API_KEY  = "gsk_..."
#
# OpenAI:
#   LPR_LLM_PROVIDER = "openai"
#   LPR_LLM_API_KEY  = "sk-..."
#   LPR_LLM_MODEL    = "gpt-4o-mini"
#
# Fully local via Ollama — no key leaves your machine, no cost, works offline.
# Run `ollama serve` and `ollama pull llama3` first:
#   LPR_LLM_PROVIDER = "openai"
#   LPR_LLM_BASE_URL = "http://localhost:11434/v1"
#   LPR_LLM_API_KEY  = "ollama"
#   LPR_LLM_MODEL    = "llama3"
